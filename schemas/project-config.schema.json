{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentic Web Design OS Project Config v4.10",
  "type": "object",
  "required": ["system_version","project_type","delivery_profile","visual_identity_mode","content_model","technology","accessibility_target","implementation_root"],
  "properties": {
    "system_version": {"const":"6.2.2"},
    "project_type": {"enum":["undetermined","landing"]},
    "delivery_profile": {"enum":["focused","standard","extended"]},
    "visual_identity_mode": {"enum":["undetermined","inherit","evolve","establish"]},
    "content_model": {"enum":["undetermined","static","editorial","managed","application","mixed"]},
    "technology": {
      "type":"object",
      "required":["status","choice","decision_artifact"],
      "properties": {
        "status":{"enum":["undetermined","selected"]},
        "choice":{"type":"string","minLength":1},
        "decision_artifact":{"const":"technology-decision.md"}
      },
      "additionalProperties":false
    },
    "accessibility_target": {"type":"string","minLength":1},
    "implementation_root": {"type":"string","minLength":1}
  },
  "additionalProperties": false
}


